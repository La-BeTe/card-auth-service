# Copy to .env and adjust. Placeholder values for local development only.
PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=card_auth_service

# Used when running the app outside Docker (Postgres is published on host port 5431).
# docker compose overrides this for the app container and points it at the db service.
DATABASE_URL=postgresql://postgres:change-me@localhost:5431/card_auth_service

# Card token of the settlement account that takes the other side of every ledger posting.
SYSTEM_ACCOUNT_TOKEN=SYSTEM_SETTLEMENT
